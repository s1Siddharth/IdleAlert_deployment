# ==============================================================================
# IDLEALERT - TEXTBEE SMS GATEWAY CONFIGURATION
# ==============================================================================

ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
# Comma-separated browser origins. In production, use your real HTTPS frontend URL.
CORS_ORIGINS=http://localhost:5173
# Optional: PostgreSQL is recommended for multi-instance production deployments.
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/idlealert
# Configure TextBee SMS provider to enable REAL cellular SMS alert delivery
# via your connected Android device.
# ==============================================================================

TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# SMS Rate Limit in seconds (prevents alert spamming during continuous detection)
SMS_RATE_LIMIT_SECONDS=300
